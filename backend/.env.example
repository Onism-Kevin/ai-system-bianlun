# 思辨工坊 backend 环境变量模板（S0-2 产出）
# 复制为 backend/.env 并填入真实值。本文件只含占位符，可安全提交。
# .env 已在 .gitignore 中，真实密钥不入库。

# --- 模型网关（OpenAI 兼容）---
# Base URL：指向网关的 /v1
MODEL_BASE_URL=http://127.0.0.1:8326/v1
# API Key：真实 key 只填在 backend/.env，切勿写进本文件或任何提交物
MODEL_API_KEY=<YOUR_MODEL_API_KEY>
# 默认模型：spike（S0-3b/S0-7）确定后填实值
MODEL_DEFAULT=<MODEL_DEFAULT_AFTER_SPIKE>

# --- MySQL 数据库连接 ---
# 注意：密码含特殊字符（如 @）时必须 percent-encode（@ -> %40），
# 否则 URL 解析会把密码误当 host。示例占位：<ROOT_PASSWORD_ENCODED>
DATABASE_URL=mysql+pymysql://root:<ROOT_PASSWORD_ENCODED>@127.0.0.1:3306/sfb_dev?charset=utf8mb4

# --- 应用密钥 ---
# JWT 签名密钥：生产必须换成随机长串
JWT_SECRET=change_me_in_production
